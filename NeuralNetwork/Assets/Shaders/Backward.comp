#version 460 core

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer ActivationsBuffer { float activations[]; };
layout(std430, binding = 1) readonly buffer TargetsBuffer { float targets[]; };
layout(std430, binding = 2) writeonly buffer DeltasBuffer { float deltas[]; };

layout(push_constant) uniform Params
{
	uint OutputCount;
	uint OutputOffset;
	uint ActivationStride;
	uint TargetOffset;
} params;

void main()
{
	uint j = gl_GlobalInvocationID.x;
	uint s = gl_GlobalInvocationID.y;
	if (j >= params.OutputCount)
		return;

	uint index = s * params.ActivationStride + params.OutputOffset + j;
	float a = activations[index];
	float t = targets[params.TargetOffset + s * params.OutputCount + j];

	// Cross-entropy loss: with a sigmoid or softmax output the delta simplifies to a - t
	deltas[index] = a - t;
}
